FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// One-blade axial-flow rotor for the near-tip virtual-camber (Trigaux et al.
// 2024, F_Cl) tests. Six elements span r = 0.05 m to r = 0.45 m of a 0.45 m
// rotor; the chord tapers linearly from 0.06 m to 0.03 m so the tip element
// sits inside the table range ((d/c)_eff ~ 0.8) and the root element far
// outside it ((d/c)_eff > 3.5). Zero twist, TSR 5, no Dag & Sorensen
// correction: the first step is evaluated on the frozen uniform inflow.
// Allrun builds system/fvOptions from this template:
//   -off      no nearTipCorrection dictionary (baseline)
//   -on       nearTipCorrection from the committed Trigaux CSV (@TABLE@)
//   -twocol   nearTipCorrection from the two-column system/fcl_two_column.dat
//   -offblock nearTipCorrection { active off; } (must equal -off)

turbine
{
    type            axialFlowTurbineALSource;
    active          on;

    axialFlowTurbineALSourceCoeffs
    {
        fieldNames          (U);
        selectionMode       cellSet;
        cellSet             turbine;
        origin              (0 0 0);
        axis                (-1 0 0);
        verticalDirection   (0 0 1);
        freeStreamVelocity  (10 0 0);
        tipSpeedRatio       5.0;
        rotorRadius         0.45;

        dynamicStall
        {
            active          off;
            dynamicStallModel LeishmanBeddoes;
        }

        endEffects
        {
            active          off;
            endEffectsModel Glauert;
        }

@NEARTIP@
        blades
        {
            blade1
            {
                writePerf           true;
                writeElementPerf    true;
                elementType         actuatorLineElement;
                nElements           6;
                elementProfiles     (S809 S809 S809 S809 S809 S809);
                elementData
                (
                    (0.0  0.05  0.0  0.06  0.25  0.0)
                    (0.0  0.45  0.0  0.03  0.25  0.0)
                );
            }
        }

        profileData
        {
            S809
            {
                data (#include "S809.dat");
            }
        }
    }
}

