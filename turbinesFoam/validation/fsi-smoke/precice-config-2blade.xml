<?xml version="1.0" encoding="UTF-8" ?>
<!--
  preCICE configuration: two-blade ASM FSI smoke test (cases 2 and 3).

  Fluid = OpenFOAM + precice-openfoam-adapter (two pointCloud interfaces)
  Solid = dummy-solid (mock structural participant, two meshes)

  Each blade has its own point cloud and its own exchange; the blade
  subdictionaries carry distinct field names (surfaceCoords1/2, ...).
-->
<precice-configuration>
  <log>
    <sink
      type="stream"
      output="stdout"
      filter="%Severity% > debug"
      format="preCICE:%ColorizedSeverity% %Message%"
      enabled="true" />
    <sink
      type="file"
      output="precice-Fluid.log"
      filter="%Severity% > debug"
      format="preCICE:%ColorizedSeverity% %Message%"
      enabled="true" />
  </log>

  <data:vector name="Force" />
  <data:vector name="Displacement" />

  <mesh name="Blade1-Fluid" dimensions="3">
    <use-data name="Force" />
    <use-data name="Displacement" />
  </mesh>
  <mesh name="Blade1-Solid" dimensions="3">
    <use-data name="Force" />
    <use-data name="Displacement" />
  </mesh>

  <mesh name="Blade2-Fluid" dimensions="3">
    <use-data name="Force" />
    <use-data name="Displacement" />
  </mesh>
  <mesh name="Blade2-Solid" dimensions="3">
    <use-data name="Force" />
    <use-data name="Displacement" />
  </mesh>

  <participant name="Fluid">
    <provide-mesh name="Blade1-Fluid" />
    <provide-mesh name="Blade2-Fluid" />
    <write-data name="Force" mesh="Blade1-Fluid" />
    <read-data name="Displacement" mesh="Blade1-Fluid" />
    <write-data name="Force" mesh="Blade2-Fluid" />
    <read-data name="Displacement" mesh="Blade2-Fluid" />
  </participant>

  <participant name="Solid">
    <receive-mesh name="Blade1-Fluid" from="Fluid" />
    <provide-mesh name="Blade1-Solid" />
    <receive-mesh name="Blade2-Fluid" from="Fluid" />
    <provide-mesh name="Blade2-Solid" />

    <mapping:nearest-neighbor
      direction="read" from="Blade1-Fluid" to="Blade1-Solid" constraint="conservative" />
    <mapping:nearest-neighbor
      direction="write" from="Blade1-Solid" to="Blade1-Fluid" constraint="consistent" />
    <mapping:nearest-neighbor
      direction="read" from="Blade2-Fluid" to="Blade2-Solid" constraint="conservative" />
    <mapping:nearest-neighbor
      direction="write" from="Blade2-Solid" to="Blade2-Fluid" constraint="consistent" />

    <write-data name="Displacement" mesh="Blade1-Solid" />
    <read-data name="Force" mesh="Blade1-Solid" />
    <write-data name="Displacement" mesh="Blade2-Solid" />
    <read-data name="Force" mesh="Blade2-Solid" />
  </participant>

  <m2n:sockets acceptor="Fluid" connector="Solid" />

  <coupling-scheme:serial-explicit>
    <participants first="Fluid" second="Solid" />
    <max-time-windows value="50" />
    <time-window-size value="0.008" />
    <exchange data="Force" mesh="Blade1-Fluid" from="Fluid" to="Solid" />
    <exchange data="Displacement" mesh="Blade1-Fluid" from="Solid" to="Fluid" />
    <exchange data="Force" mesh="Blade2-Fluid" from="Fluid" to="Solid" />
    <exchange data="Displacement" mesh="Blade2-Fluid" from="Solid" to="Fluid" />
  </coupling-scheme:serial-explicit>
</precice-configuration>
